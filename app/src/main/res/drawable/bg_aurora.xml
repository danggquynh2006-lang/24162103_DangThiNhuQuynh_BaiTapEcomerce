<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base Midnight Purple -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/purple_dark"/>
        </shape>
    </item>

    <!-- Violet glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="85%"
                android:centerY="15%"
                android:startColor="#CC7654B8"
                android:centerColor="#66542A91"
                android:endColor="#00211B45"/>
        </shape>
    </item>

    <!-- Lavender glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerX="10%"
                android:centerY="90%"
                android:startColor="#99A69AE8"
                android:centerColor="#44542A91"
                android:endColor="#00211B45"/>
        </shape>
    </item>

    <!-- Soft violet light -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:centerX="55%"
                android:centerY="50%"
                android:startColor="#557654B8"
                android:endColor="#00211B45"/>
        </shape>
    </item>

</layer-list>
